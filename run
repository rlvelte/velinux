#!/bin/sh
set -eu
cd "$(dirname "$0")"

become_prompt=""
if [ "$(id -u)" -eq 0 ]; then
    sudo=""
else
    sudo="sudo"
    sudo -k 2>/dev/null || true
    if ! sudo -n true >/dev/null 2>&1; then
        if [ -t 0 ]; then
            become_prompt="--ask-become-pass"
            echo "note: sudo requires a password; ansible will prompt for it"
        else
            echo "error: sudo requires a password and no terminal is available to ask for it" >&2
            exit 1
        fi
    fi
fi


$sudo zypper refresh
$sudo zypper install -y python313-pipx

export PATH="$HOME/.local/bin:$PATH"

if ! command -v ansible-playbook >/dev/null 2>&1; then
    echo "installing ansible-core via pipx..."
    pipx install ansible-core
    pipx ensurepath >/dev/null 2>&1 || true
fi

if ! command -v ansible-playbook >/dev/null 2>&1; then
    echo "error: ansible-playbook not found after installation" >&2
    exit 1
fi

if ! ansible-galaxy collection list community.general 2>/dev/null | grep -q community.general; then
    echo "installing community.general collection..."
    ansible-galaxy collection install community.general
fi

if [ -r ansible.cfg ]; then
    ANSIBLE_CONFIG="$PWD/ansible.cfg"
    export ANSIBLE_CONFIG
fi

export ANSIBLE_ROLES_PATH="$PWD/roles"
exec ansible-playbook $become_prompt --become --inventory "$PWD/inventory/hosts.yml" playbooks/site.yml "$@"