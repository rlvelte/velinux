{
  "$schema": "bundle.schema.json",
  "info": {
    "name": "JetBrains Toolbox",
    "desc": "Downloads the latest toolbox archive and install in ~/.local/share.",
    "icon": "\uE808"
  },
  "zypper": [
    "curl",
    "libX11-6",
    "libXext6",
    "libXi6",
    "libXtst6",
    "libXrender1",
    "libXss1",
    "libxcb1",
    "libxcb-keysyms1",
    "libfontconfig1",
    "libfreetype6",
    "Mesa-libGL1",
    "libxkbcommon0"
  ],
  "pre": [
    "rm -rf /tmp/jetbrains-toolbox-download"
  ],
  "post": [
    "mkdir -p /tmp/jetbrains-toolbox-download",
    "curl -fsSL 'https://data.services.jetbrains.com/products/download?code=TBA&platform=linux' -o /tmp/jetbrains-toolbox-download/jetbrains-toolbox.tar.gz",
    "rm -rf ~/.local/share/JetBrains/Toolbox",
    "mkdir -p ~/.local/share/JetBrains/Toolbox",
    "tar -xzf /tmp/jetbrains-toolbox-download/jetbrains-toolbox.tar.gz -C ~/.local/share/JetBrains/Toolbox --strip-components=1",
    "mkdir -p ~/.local/bin",
    "ln -sf ~/.local/share/JetBrains/Toolbox/bin/jetbrains-toolbox ~/.local/bin/jetbrains-toolbox",
    "mkdir -p ~/.local/share/applications",
    "cp ~/.local/share/JetBrains/Toolbox/bin/jetbrains-toolbox.desktop ~/.local/share/applications/jetbrains-toolbox.desktop",
    "sed -i 's|^Exec=jetbrains-toolbox$|Exec=~/.local/share/JetBrains/Toolbox/bin/jetbrains-toolbox|' ~/.local/share/applications/jetbrains-toolbox.desktop",
    "sed -i 's|^Icon=jetbrains-toolbox$|Icon=~/.local/share/JetBrains/Toolbox/bin/toolbox-tray-color.png|' ~/.local/share/applications/jetbrains-toolbox.desktop",
    "rm -rf /tmp/jetbrains-toolbox-download"
  ]
}