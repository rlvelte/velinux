{
  "$schema": "bundle.schema.json",
  "zypper": [
    "podman",
    "podman-docker",
    "k3s-selinux",
    "k9s",
    "helm"
  ],
  "post": [
    "sudo systemctl enable --now podman.socket",
    "systemctl --user enable --now podman.socket",
    "curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC=\"--write-kubeconfig-mode 644\" sh -s -"
  ]
}

